# GProA EDGE - Environment Variables
# DEFAULT VALUES FOR DEMO MODE (no API keys required)
# Copy this to .env and override as needed

# ── Gemini API (optional - uses mock responses if not set) ───────────────────
# Get from: https://aistudio.google.com/app/apikeys
GEMINI_API_KEY=your_gemini_api_key_here

# Google Drive Integration (Future use)
# ------------------------------------------------------------------------------
# Set this to the JSON content of your Service Account or path to credentials.json
GOOGLE_DRIVE_CREDENTIALS=

# ── Database ────────────────────────────────────────────────────────────────
# If MONGO_URL is set → uses MongoDB (requires Atlas connection string)
# If MONGO_URL is EMPTY → uses SQLite file (./data/gproa_edge.db)
MONGO_URL=
DB_NAME=gproa_edge

# ── CORS ────────────────────────────────────────────────────────────────────
# For local dev: http://localhost:3000
# For Render: https://gproa-edge-frontend.onrender.com
CORS_ORIGINS=*

# ── Misc ─────────────────────────────────────────────────────────────────────
FRONTEND_URL=
# DEMO_MODE=true enables mock AI responses when no API key
DEMO_MODE=false
